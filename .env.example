# ========================================================
# CENDRIC AI FINANCE PLATFORM - MERN STACK CONFIGURATION
# ========================================================
# Copy this file to 'server/.env' or project root '.env':
#   copy .env.example server\.env   (Windows)
#   cp .env.example server/.env     (Mac/Linux)

# Port for the Node/Express backend & static client
PORT=5000

# Secret key used to sign and verify user JWT auth tokens
JWT_SECRET=cendric_super_secret_jwt_key_2024_change_this

# Google Gemini API Key & Model (Optional)
# Get a free key from: https://aistudio.google.com/app/apikey
# Powers the streaming Chat Assistant & Receipt Scanner. If omitted, built-in RAG & heuristics are used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# MongoDB Connection String (MERN Stack Database)
# 1. MongoDB Atlas (Cloud):
#    MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cendric?retryWrites=true&w=majority
# 2. Local MongoDB Server:
#    MONGODB_URI=mongodb://127.0.0.1:27017/cendric
# Note: If MongoDB is offline, Cendric will automatically fall back to server/data/cendric_db.json.
MONGODB_URI=mongodb://127.0.0.1:27017/cendric

# Environment mode
NODE_ENV=development
