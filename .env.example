# ========================================================
# CENDRIC AI FINANCE PLATFORM - ENVIRONMENT CONFIGURATION
# ========================================================
# Copy this file to 'server/.env' to run locally:
#   copy .env.example server\.env   (Windows)
#   cp .env.example server/.env     (Mac/Linux)

# Port for the Node/Express backend & static client
PORT=5000

# Secret key used to sign and verify user JWT auth tokens
JWT_SECRET=cendric_super_secret_jwt_key_2024_change_this

# Google Gemini API Key (Optional)
# Get a free key from: https://aistudio.google.com/app/apikey
# Powers the streaming Chat Assistant & Receipt Scanner. If omitted, built-in RAG & heuristics are used.
GEMINI_API_KEY=

# MongoDB Atlas Connection String (Optional)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cendric?retryWrites=true&w=majority
# If omitted or unreachable, Cendric automatically falls back to its persistent local JSON database (server/data/cendric_db.json).
MONGODB_URI=

# Environment mode
NODE_ENV=development
